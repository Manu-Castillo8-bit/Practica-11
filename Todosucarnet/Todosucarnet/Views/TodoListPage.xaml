<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Todosucarnet.Models"
             x:Class="Todosucarnet.Views.TodoListPage"
             Title="Todo">
    <Grid RowDefinitions="*, Auto">
        <CollectionView x:Name="ItemsCollection" VerticalOptions="Fill"
                        ItemsSource="{Binding Items}"
                        SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                    <Grid ColumnDefinitions="*, Auto" Padding="20">
                        <Label Text="{Binding Name}"
                               VerticalTextAlignment="Center"/>
                        <Label Text="👍"
                               Grid.Column="1"
                               VerticalTextAlignment="Center"
                               IsVisible="{Binding Done}"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button x:Name="AddButton" Grid.Row="1" Text="Add new Item" Margin="20"/>
    </Grid>
</ContentPage>
